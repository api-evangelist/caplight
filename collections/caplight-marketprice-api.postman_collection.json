      "id": "99b8d0d5-d0d3-4bb4-8908-05011e5e2a80",
      "name": "MarketPrice",
      "description": {
        "content": "Caplight's proprietary MarketPrice estimate, calculated using executed trades, company primary rounds, bids/offers, fund marks, 409a valuations, and comps performance.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "b2236a1e-e1af-4791-a883-7fcb2fe767b6",
          "name": "All MarketPrices",
          "request": {
            "name": "All MarketPrices",
            "description": {
              "content": "Returns the latest MarketPrice for all companies where a Caplight MarketPrice exists. Each company's best-available price model is returned (secondaryMarket by default, falling back to fundMarks); the priceModel field on each row indicates which model produced it.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "all-marketprices"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "pageNumber",
                  "value": "<number>",
                  "description": "Page number (1-based). First page is 1."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "Optional. Filters the response to companies whose latest MarketPrice was produced by the given model. Allowed values (case-insensitive): \"secondaryMarket\" or \"fundMarks\". When omitted, every company's best-available MarketPrice is returned. An unrecognized value returns HTTP 400.",
                "key": "x-price-model",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
