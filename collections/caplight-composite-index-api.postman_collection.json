        {
          "id": "3e587933-8ce5-44b6-bb99-b6a1594d14d8",
          "name": "Get composite index timeseries",
          "request": {
            "name": "Get composite index timeseries",
            "description": {
              "content": "Returns a market-cap weighted composite index timeseries for private companies in a given sector or vertical, or the overall Caplight Top 20 (`scope=overall`). The index is rebased to 100 on the start date; each day includes the constituent list and weights. Companies that exit the private market (M&A, IPO, or wind-down) are excluded after their exit date. Only the parameters documented below are accepted — any other parameter is rejected with a 400 so index values are never silently computed under non-standard settings.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "composite-index"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "sector",
                  "value": "<string>",
                  "description": "Sector name to build the index from. Provide exactly one of `sector`, `vertical`, or `scope=overall`. Use `/composite-index/sectors` for valid names."
                },
                {
                  "disabled": false,
                  "key": "vertical",
                  "value": "<string>",
                  "description": "Vertical name to build the index from. Provide exactly one of `sector`, `vertical`, or `scope=overall`. Use `/composite-index/verticals` for valid names."
                },
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "<string>",
                  "description": "Set to `overall` for the Caplight Top 20 — the flagship private-market index across all sectors (the 20 most liquid private companies, price-per-share weighted, monthly rebalance). Cannot be combined with `sector` or `vertical`."
                },
                {
                  "disabled": false,
                  "key": "startDate",
                  "value": "<string>",
                  "description": "Start date for the timeseries. Defaults to 1 year ago."
                },
                {
                  "disabled": false,
                  "key": "endDate",
                  "value": "<string>",
                  "description": "End date for the timeseries. Defaults to yesterday."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
